---
const name = "Christopher Kelly";
const title = "Full-Stack Developer";
const headline = "I build software people actually use.";
const subline =
  "Full-stack web and mobile, from the C#/.NET API to the UI. One of my apps runs a home-health nurse's daily schedule and routes in the field.";
const githubUrl = "https://github.com/CTK1215";
---

<section
  class="hero relative flex flex-col justify-center pt-12 pb-20 sm:pt-20 sm:pb-28 lg:pt-28 lg:pb-36"
  aria-labelledby="hero-heading"
>
  <p
    class="hero-eyebrow font-mono text-xs uppercase tracking-[0.18em] text-accent sm:text-sm"
  >
    {name} <span class="text-text-muted" aria-hidden="true">·</span> {title}
  </p>

  <h1
    id="hero-heading"
    class="hero-headline mt-5 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-tight text-text sm:text-5xl lg:text-6xl xl:text-7xl"
  >
    {headline}
  </h1>

  <p
    class="hero-subline mt-6 max-w-2xl text-lg leading-relaxed text-text-muted sm:text-xl"
  >
    {subline}
  </p>

  <div class="hero-ctas mt-10 flex flex-wrap items-center gap-3 sm:gap-4">
    <a
      href="#work"
      class="focus-ring inline-flex items-center justify-center rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-bg transition-colors duration-150 hover:bg-accent-hover sm:text-base"
    >
      View Work
    </a>

    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub profile"
      class="focus-ring inline-flex items-center justify-center gap-2 rounded-md border border-border bg-transparent px-5 py-2.5 text-sm font-medium text-text transition-colors duration-150 hover:border-text-muted hover:bg-surface sm:text-base"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.1-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
        ></path>
      </svg>
      GitHub
    </a>

    <a
      href="/resume.pdf"
      download
      class="focus-ring inline-flex items-center justify-center rounded-md border border-border bg-transparent px-5 py-2.5 text-sm font-medium text-text transition-colors duration-150 hover:border-text-muted hover:bg-surface sm:text-base"
    >
      Resume
    </a>
  </div>
</section>

<style>
  .focus-ring:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
