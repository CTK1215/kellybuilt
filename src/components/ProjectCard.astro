---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, status, statusKind, tagline, summary, tech, cover, links } =
  project.data;
const caseStudyHref = `/work/${project.id}`;

const badgeClass =
  statusKind === "production"
    ? "border-accent/40 bg-accent/10 text-accent"
    : statusKind === "in-progress"
      ? "border-amber-400/40 bg-amber-400/10 text-amber-300"
      : "border-border bg-bg/40 text-text-muted";

const dotClass =
  statusKind === "production"
    ? "bg-accent"
    : statusKind === "in-progress"
      ? "bg-amber-400"
      : "bg-text-muted";

const externalLinks = [
  { key: "live", label: "Live", href: links.live },
  { key: "demo", label: "Demo", href: links.demo },
  { key: "repo", label: "Repo", href: links.repo },
  { key: "video", label: "Video", href: links.video },
].filter((l): l is { key: string; label: string; href: string } => !!l.href);
---

<article
  class:list={[
    "project-card group relative flex flex-col overflow-hidden rounded-xl border border-border bg-surface transition-[transform,border-color,box-shadow] duration-150",
    featured && "lg:flex-row",
  ]}
>
  <div
    class:list={[
      "project-cover relative w-full overflow-hidden bg-bg",
      featured ? "aspect-[16/10] lg:aspect-auto lg:w-1/2" : "aspect-[16/10]",
    ]}
  >
    {
      cover ? (
        <Image
          src={cover}
          alt={`${title} preview`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="cover-fallback flex h-full w-full items-center justify-center">
          <span class="px-6 text-center font-mono text-lg tracking-tight text-text-muted sm:text-xl">
            {title}
          </span>
        </div>
      )
    }
  </div>

  <div
    class:list={[
      "flex flex-1 flex-col p-6 sm:p-7",
      featured && "lg:p-9",
    ]}
  >
    <div class="flex flex-wrap items-center gap-2">
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium",
          badgeClass,
        ]}
      >
        <span
          class:list={["h-1.5 w-1.5 rounded-full", dotClass]}
          aria-hidden="true"
        ></span>
        {status}
      </span>
    </div>

    <h3
      class:list={[
        "mt-4 font-semibold tracking-tight text-text",
        featured ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
      ]}
    >
      <a
        href={caseStudyHref}
        class="focus-ring rounded-sm transition-colors duration-150 hover:text-accent"
      >
        {title}
      </a>
    </h3>

    <p
      class:list={[
        "mt-3 text-text",
        featured ? "text-base sm:text-lg" : "text-sm sm:text-base",
      ]}
    >
      {tagline}
    </p>

    <p
      class:list={[
        "mt-3 text-text-muted",
        featured ? "text-base leading-relaxed" : "text-sm leading-relaxed",
      ]}
    >
      {summary}
    </p>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${title} tech stack`}>
      {
        tech.map((t) => (
          <li class="rounded-md border border-border bg-bg/40 px-2 py-1 font-mono text-xs text-text-muted">
            {t}
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-wrap items-center gap-3 pt-1">
      <a
        href={caseStudyHref}
        class="focus-ring inline-flex items-center gap-1 rounded-sm text-sm font-medium text-accent transition-colors duration-150 hover:text-accent-hover"
      >
        Read case study <span aria-hidden="true">→</span>
      </a>

      {
        externalLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} ${link.label.toLowerCase()} site`}
            class="focus-ring inline-flex items-center gap-1 rounded-md border border-border bg-bg/40 px-2.5 py-1 text-xs font-medium text-text-muted transition-colors duration-150 hover:border-text-muted hover:text-text"
          >
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .focus-ring:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cover-fallback {
    background-image:
      radial-gradient(
        ellipse at top left,
        color-mix(in oklab, var(--accent) 22%, transparent),
        transparent 60%
      ),
      linear-gradient(
        135deg,
        var(--surface) 0%,
        color-mix(in oklab, var(--surface) 70%, var(--bg)) 100%
      );
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--border) 60%, var(--text-muted));
    box-shadow: 0 8px 24px -12px color-mix(in oklab, var(--bg) 80%, black);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card * {
      transition: none !important;
    }
    .project-card:hover {
      transform: none;
    }
  }
</style>
