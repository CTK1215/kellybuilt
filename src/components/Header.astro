---
const wordmark = "chris";

const navLinks = [
  { href: "#work", label: "Work" },
  { href: "#skills", label: "Skills" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];

const githubUrl = "https://github.com/CTK1215";
const resumeUrl = "/resume.pdf";
---

<header
  id="site-header"
  class="site-header sticky top-0 z-50 w-full border-b border-transparent bg-bg/70 backdrop-blur-md transition-[background-color,border-color,box-shadow] duration-150"
>
  <div class="mx-auto w-full max-w-[72rem] px-6 sm:px-8 lg:px-12">
    <nav
      aria-label="Primary"
      class="flex h-16 items-center justify-between gap-6"
    >
      <a
        href="/"
        class="focus-ring rounded-sm font-mono text-base font-medium tracking-tight text-text transition-colors duration-150 hover:text-accent"
        aria-label={`${wordmark}, home`}
      >
        <span>{wordmark}</span><span class="text-accent">.</span>
      </a>

      <div class="hidden items-center gap-1 md:flex">
        <ul class="flex items-center gap-1">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="focus-ring rounded-md px-3 py-2 text-sm text-text-muted transition-colors duration-150 hover:text-text"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="focus-ring ml-1 inline-flex h-9 w-9 items-center justify-center rounded-md text-text-muted transition-colors duration-150 hover:text-text"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.1-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
            />
          </svg>
        </a>

        <a
          href={resumeUrl}
          download
          class="focus-ring ml-2 inline-flex items-center justify-center rounded-md bg-accent px-3.5 py-2 text-sm font-medium text-bg transition-colors duration-150 hover:bg-accent-hover"
        >
          Resume
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="focus-ring inline-flex h-10 w-10 items-center justify-center rounded-md text-text-muted transition-colors duration-150 hover:text-text md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg
          class="icon-close hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-bg/95 backdrop-blur-md md:hidden"
  >
    <div class="mx-auto w-full max-w-[72rem] px-6 py-4 sm:px-8">
      <ul class="flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-menu-link
                class="focus-ring block rounded-md px-3 py-3 text-base text-text-muted transition-colors duration-150 hover:text-text"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-menu-link
            class="focus-ring flex items-center gap-2 rounded-md px-3 py-3 text-base text-text-muted transition-colors duration-150 hover:text-text"
            aria-label="GitHub profile"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.1-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
              />
            </svg>
            GitHub
          </a>
        </li>
        <li class="pt-2">
          <a
            href={resumeUrl}
            download
            data-menu-link
            class="focus-ring inline-flex w-full items-center justify-center rounded-md bg-accent px-3.5 py-3 text-base font-medium text-bg transition-colors duration-150 hover:bg-accent-hover"
          >
            Resume
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .focus-ring:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .site-header.is-scrolled {
    background-color: color-mix(in oklab, var(--bg) 88%, transparent);
    border-bottom-color: var(--border);
    box-shadow: 0 1px 0 0 color-mix(in oklab, var(--border) 60%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header * {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const panel = document.getElementById("mobile-menu");
  const iconOpen = toggle?.querySelector(".icon-open");
  const iconClose = toggle?.querySelector(".icon-close");

  // Scroll state (rAF-debounced)
  if (header) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 12;
        header.classList.toggle("is-scrolled", scrolled);
        ticking = false;
      });
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Mobile menu
  if (toggle && panel) {
    const openMenu = () => {
      panel.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close menu");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    };

    const closeMenu = (returnFocus = false) => {
      panel.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      if (returnFocus) toggle.focus();
    };

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    toggle.addEventListener("click", () => {
      if (isOpen()) closeMenu(true);
      else openMenu();
    });

    // Close on link click
    panel.querySelectorAll("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => closeMenu(false));
    });

    // Escape closes and returns focus
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        e.preventDefault();
        closeMenu(true);
      }
    });

    // Outside click closes
    document.addEventListener("click", (e) => {
      if (!isOpen()) return;
      const target = e.target as Node;
      if (panel.contains(target) || toggle.contains(target)) return;
      closeMenu(false);
    });

    // Close if viewport grows past md (768px)
    const mql = window.matchMedia("(min-width: 768px)");
    mql.addEventListener("change", (ev) => {
      if (ev.matches && isOpen()) closeMenu(false);
    });
  }
</script>
