---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const badgeClass =
  d.statusKind === "production"
    ? "border-accent/40 bg-accent/10 text-accent"
    : d.statusKind === "in-progress"
      ? "border-amber-400/40 bg-amber-400/10 text-amber-300"
      : "border-border bg-bg/40 text-text-muted";

const dotClass =
  d.statusKind === "production"
    ? "bg-accent"
    : d.statusKind === "in-progress"
      ? "bg-amber-400"
      : "bg-text-muted";

const externalLinks = [
  { key: "live", label: "Live", href: d.links.live },
  { key: "demo", label: "Demo", href: d.links.demo },
  { key: "repo", label: "Repo", href: d.links.repo },
  { key: "video", label: "Video", href: d.links.video },
].filter((l): l is { key: string; label: string; href: string } => !!l.href);
---

<BaseLayout
  title={`${d.title} — Case study`}
  description={d.summary}
>
  <div class="case-study">
    <a
      href="/#work"
      class="focus-ring inline-flex items-center gap-1.5 rounded-sm text-sm font-medium text-text-muted transition-colors duration-150 hover:text-text"
    >
      <span aria-hidden="true">←</span> Back to work
    </a>

    <header class="mt-8 sm:mt-10">
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium",
          badgeClass,
        ]}
      >
        <span
          class:list={["h-1.5 w-1.5 rounded-full", dotClass]}
          aria-hidden="true"
        ></span>
        {d.status}
      </span>

      <h1
        class="mt-5 text-4xl font-semibold leading-[1.1] tracking-tight text-text sm:text-5xl lg:text-6xl"
      >
        {d.title}
      </h1>

      <p
        class="mt-5 max-w-3xl text-lg leading-relaxed text-text-muted sm:text-xl"
      >
        {d.tagline}
      </p>

      <ul
        class="mt-6 flex flex-wrap gap-2"
        aria-label={`${d.title} tech stack`}
      >
        {
          d.tech.map((t) => (
            <li class="rounded-md border border-border bg-bg/40 px-2 py-1 font-mono text-xs text-text-muted">
              {t}
            </li>
          ))
        }
      </ul>

      {
        externalLinks.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-3">
            {externalLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${d.title} ${link.label.toLowerCase()} site`}
                class="focus-ring inline-flex items-center gap-1.5 rounded-md border border-border bg-bg/40 px-3 py-1.5 text-sm font-medium text-text transition-colors duration-150 hover:border-text-muted hover:bg-surface"
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div
      class="case-study-cover relative mt-10 overflow-hidden rounded-xl border border-border bg-surface sm:mt-12"
    >
      {
        d.cover ? (
          <Image
            src={d.cover}
            alt={`${d.title} preview`}
            loading="lazy"
            decoding="async"
            class="aspect-[16/8] w-full object-cover sm:aspect-[16/7]"
          />
        ) : (
          <div class="cover-fallback flex aspect-[16/8] w-full items-center justify-center sm:aspect-[16/7]">
            <span class="px-6 text-center font-mono text-xl tracking-tight text-text-muted sm:text-2xl">
              {d.title}
            </span>
          </div>
        )
      }
    </div>

    <article class="case-study-body mt-12 max-w-3xl sm:mt-14">
      <Content />
    </article>
  </div>
</BaseLayout>

<style>
  .focus-ring:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cover-fallback {
    background-image:
      radial-gradient(
        ellipse at top left,
        color-mix(in oklab, var(--accent) 22%, transparent),
        transparent 60%
      ),
      linear-gradient(
        135deg,
        var(--surface) 0%,
        color-mix(in oklab, var(--surface) 70%, var(--bg)) 100%
      );
  }
</style>
