---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="flex min-h-[60vh] flex-col justify-center">
    <p class="font-mono text-sm uppercase tracking-widest text-accent">
      Portfolio
    </p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">
      Chris <span class="text-accent">—</span> Full-Stack Developer
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-text-muted">
      Theme check: dark high-contrast surface, Geist Variable for body, teal
      accent for emphasis. Hero content lands here next.
    </p>
  </section>
</BaseLayout>
